req">报警请求</field><value name="VALUE"><block type="logic_boolean" id="blk0165"><field name="BOOL">FALSE</field></block></value><next><block type="variables_set" id="blk0168"><field name="VAR" id="var_vibreq">振动请求</field><value name="VALUE"><block type="logic_boolean" id="blk0167"><field name="BOOL">TRUE</field></block></value><next><block type="pxt_controls_for" id="blk0153"><value name="VAR"><block type="variables_get_reporter"><mutation duplicateondrag="true"></mutation><field name="VAR">i</field></block></value><value name="TO"><shadow type="math_whole_number"><field name="NUM">2</field></shadow><block type="math_arithmetic" id="blk0152"><field name="OP">MINUS</field><value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="variables_get" id="blk0151"><field name="VAR" id="var_alarmn">报警次数</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></value><statement name="DO"><block type="music_playable_play" id="blk0150"><field name="playbackMode">music.PlaybackMode.UntilDone</field><value name="toPlay"><block type="music_tone_playable"><value name="note"><shadow type="device_note"><field name="name">262</field></shadow><block type="variables_get" id="blk0149"><field name="VAR" id="var_alarmhz">报警音调</field></block></value><value name="duration"><shadow type="device_beat"><field name="fraction">BeatFraction.Half</field></shadow></value></block></value></block></statement><next><block type="pxt_controls_for" id="blk0164"><value name="VAR"><block type="variables_get_reporter"><mutation duplicateondrag="true"></mutation><field name="VAR">j</field></block></value><value name="TO"><shadow type="math_whole_number"><field name="NUM">1</field></shadow><block type="math_arithmetic" id="blk0163"><field name="OP">MINUS</field><value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="variables_get" id="blk0162"><field name="VAR" id="var_blinkn">闪灯次数</