ck></statement><next><block type="pxt_controls_for" id="blk0193"><value name="VAR"><block type="variables_get_reporter"><mutation duplicateondrag="true"></mutation><field name="VAR">j</field></block></value><value name="TO"><shadow type="math_whole_number"><field name="NUM">1</field></shadow><block type="math_arithmetic" id="blk0192"><field name="OP">MINUS</field><value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="variables_get" id="blk0191"><field name="VAR" id="var_blinkn">闪灯次数</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></value><statement name="DO"><block type="neopixel_set_strip_color" id="blk0184"><value name="strip"><block type="variables_get" id="blk0183"><field name="VAR" id="var_strip">strip</field></block></value><value name="rgb"><shadow type="neopixel_colors"><field name="color">NeoPixelColors.Red</field></shadow></value><next><block type="device_pause" id="blk0186"><value name="pause"><shadow type="timePicker"><field name="ms">500</field></shadow><block type="variables_get" id="blk0185"><field name="VAR" id="var_blinkms">闪灯间隔</field></block></value><next><block type="neopixel_clear" id="blk0188"><value name="strip"><block type="variables_get" id="blk0187"><field name="VAR" id="var_strip">strip</field></block></value><next><block type="device_pause" id="blk0190"><value name="pause"><shadow type="timePicker"><field name="ms">500</field></shadow><block type="variables_get" id="blk0189"><field name="VAR" id="var_blinkms">闪灯间隔</field></block></value></block></next></block></next></block></next></block></statement><next><block type="robotbit_stop" id="blk0198"><field name="index">robotbit.Motors.M1A</field><next><block type="variables_set" id="blk0200"><field name="VAR" id="var_busy">动作中</field><value name="VALUE"><block type="logic_boolean" id="blk0199"><field name="BOOL">FALSE</field></block></value></block></next><comment pinned="false">报警动作结束，停止振动</comment></block></next></block></next></block></next><comment pinned="false">通知循环4：与声光同时开始振动</comment></block></next></block></statement><next><block type="device_pause" id="blk0203"><value name="pause"><shadow type="timePicker"><field name="ms">20</field></shadow></value></block></next></block></statement><comment pinned="false">循环2 重度报警：蜂鸣+红灯闪烁（次数见参数），结束时停止振动</comment></block><block type="device_forever" id="top_warn" x="1440" y="0"><statement name="HANDLER"><block type="controls_if" id="blk0214"><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="variables_get" id="blk0213"><field name="VAR" id="var_wreq">预警请求</field></block></value><statement name="DO0"><block type="variables_set" id="blk0205"><field name="VAR" id="var_wreq">预警请求</field><value name="VALUE"><block type="logic_boolean" id="blk0204"><field name="BOOL">FALSE</field></block></value><next><block type="pxt_controls_for" id="blk0210"><value name="VAR"><block type="variables_get_reporter"><mutation duplicateondrag="true"></mutation><field name="VAR">k</field></block></value><value name="TO"><shadow type="math_whole_number"><field name="NUM">2</field></shadow><block type="math_arithmetic" id="blk0209"><field name="OP">MINUS</field><value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="variables_get" id="blk0208"><field name="VAR" id="var_warnn">预警次数</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></value><statement name="DO"><block type="music_playable_play" id="blk0207"><field name="playbackMode">music.PlaybackMode.UntilDone</field><value name="toPlay"><block type="music_tone_playable"><value name="note"><shadow type="device_note"><field name="name">262</field></shadow><block type="variables_get" id="blk0206"><field name="VAR" id="var_warnhz">预警音调</field></block></value><value name="duration"><shadow type="device_beat"><field name="fraction">BeatFraction.Quarter</field></shadow></value></block></value></block></statement><next><block type="variables_set" id="blk0212"><field name="VAR" id="var_busy">动作中</field><value name="VALUE"><block type="logic_boolean" id="blk0211"><field name="BOOL">FALSE</field></block></value></block></next></block></next></block></statement><next><block type="device_pause" id="blk0215"><value name="pause"><shadow type="timePicker"><field name="ms">20</field></shadow></value></block></next></block></statement><comment pinned="false">循环3 轻度预警：快速短鸣几次，不打扰其他循环</comment></block><block type="device_forever" id="top_vib" x="1920" y="0"><statement name="HANDLER"><block type="controls_if" id="blk0224"><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="variables_get" id="blk0223"><field name="VAR" id="var_vibreq">振动请求</field></block></value><statement name="DO0"><block type="variables_set" id="blk0217"><field name="VAR" id="var_vibreq">振动请求</field><value name="VALUE"><block type="logic_boolean" id="blk0216"><field name="BOOL">FALSE</field></block></value><next><block type="controls_if" id="blk0222"><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="logic_negate" id="blk0219"><value name="BOOL"><block type="variables_get" id="blk0218"><field name="VAR" id="var_loststop">丢失停机</field></block></value></block></value><statement name="DO0">('<block type="robotbit_motor_run" id="blk0221"><field name="index">robotbit.Motors.M1A</field><value name="speed"><shadow type="math_number"><field name="NUM">255</field></shadow><block type="variables_get" id="blk0220"><field name="VAR" id="var_motorsp">马达速度</field></block></value></block>', '已判定丢失姿态则不振动')</statement></block></next></block></statement><next><block type="device_pause" id="blk0225"><value name="pause"><shadow type="timePicker"><field name="ms">20</field></shadow></value></block></next></block></statement><comment pinned="false">循环4 同步振动：与报警声光同时启动方向盘振动马达</comment></block><comment x="30" y="60" h="120" w="200" data="0">
司机打瞌睡识别报警系统（micro:bit + RobotBit + HUSKYLENS 2）
姿态 ID 约定：1=清醒　2=打瞌睡（重度报警）　3=疲劳征兆（预警）
四个 forever 循环并行工作：检测分发（含屏幕状态显示） / 重度报警 / 轻度预警 / 同步振动
</comment></xml>