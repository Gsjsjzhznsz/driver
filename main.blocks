yable_play" id="blk0131"><field name="playbackMode">music.PlaybackMode.UntilDone</field><value name="toPlay"><block type="music_tone_playable"><value name="note"><shadow type="device_note"><field name="name">262</field></shadow><block type="variables_get" id="blk0130"><field name="VAR" id="var_warnhz">预警音调</field></block></value><value name="duration"><shadow type="device_beat"><field name="fraction">BeatFraction.Quarter</field></shadow></value></block></value></block></statement><next><block type="variables_set" id="blk0136"><field name="VAR" id="var_busy">动作中</field><value name="VALUE"><block type="logic_boolean" id="blk0135"><field name="BOOL">FALSE</field></block></value></block></next></block></next></block></statement><next><block type="device_pause" id="blk0139"><value name="pause"><shadow type="timePicker"><field name="ms">20</field></shadow></value></block></next></block></statement><comment pinned="false">循环3 轻度预警：快速短鸣几次，不打扰其他循环</comment></block><block type="device_forever" id="top_vib" x="1920" y="0"><statement name="HANDLER"><block type="controls_if" id="blk0148"><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="variables_get" id="blk0147"><field name="VAR" id="var_vibreq">振动请求</field></block></value><statement name="DO0"><block type="variables_set" id="blk0141"><field name="VAR" id="var_vibreq">振动请求</field><value name="VALUE"><block type="logic_boolean" id="blk0140"><field name="BOOL">FALSE</field></block></value><next><block type="controls_if" id="blk0146"><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="logic_negate" id="blk0143"><value name="BOOL"><block type="variables_get" id="blk0142"><field name="VAR" id="var_loststop">丢失停机</field></block></value></block></value><statement name="DO0">('<block type="robotbit_motor_run" id="blk0145"><field name="index">robotbit.Motors.M1A</field><value name="speed"><shadow type="math_number_minmax"><mutation min="-255" max="255" label="Speed" precision="0"></mutation><field name="SLIDER">255</field></shadow><block type="variables_get" id="blk0144"><field name="VAR" id="var_motorsp">马达速度</field></block></value></block>', '已判定丢失姿态则不振动')</statement></block></next></block></statement><next><block type="device_pause" id="blk0149"><value name="pause"><shadow type="timePicker"><field name="ms">20</field></shadow></value></block></next></block></statement><comment pinned="false">循环4 同步振动：与报警声光同时启动方向盘振动马达</comment></block><comment x="30" y="60" h="120" w="200" data="0">
司机打瞌睡识别报警系统（micro:bit + RobotBit + HUSKYLENS 2）
姿态 ID 约定：1=清醒　2=打瞌睡（重度报警）　3=疲劳征兆（预警）
四个 forever 循环并行工作：检测分发 / 重度报警 / 轻度预警 / 同步振动
</comment></xml>